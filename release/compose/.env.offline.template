# Copy this file to .env on the offline server and fill in real values.
# Do not commit a filled-in .env to any repository or copy it back off the
# offline server without redacting the secrets below.

# --- Image tags (must match what load_images.sh loaded) ---
API_IMAGE_NAME=hospital-directory-api
API_IMAGE_TAG=1.0.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
HOST_PORT=6000
# Shared secret sent by HCAT/HCopilot in the X-API-Key header. Required — no default.
API_KEY=

# --- PostgreSQL ---
POSTGRES_USER=hospital
# Required — no default. Use a strong value for the offline deployment.
POSTGRES_PASSWORD=
POSTGRES_DB=hospital_directory
# Only expose this if operators need direct psql/pgAdmin access from outside the host.
POSTGRES_HOST_PORT=5433

# --- pgAdmin (optional operator convenience tool; not required by HCAT/HCopilot) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Required — no default. Use a strong value for the offline deployment.
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_HOST_PORT=5050
