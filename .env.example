API_IMAGE_NAME=hospital-directory-api
API_IMAGE_TAG=1.0.0

API_HOST=0.0.0.0
API_PORT=8000
HOST_PORT=6000

# Only used for non-Docker local development (see README). Inside Docker Compose,
# the api/migrate services build DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgresql://hospital:hospital@localhost:5433/hospital_directory

API_KEY=change_me

POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=hospital_directory
POSTGRES_HOST_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_HOST_PORT=5050
